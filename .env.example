# Release Radar v1.2 - configuration reference.
# Copy to .env ONLY for a local pipeline run. Never commit .env (it is git-ignored).
# In GitHub, put the SECRET values under Settings > Secrets and variables > Actions.

# ---- Portal build (public, NOT secret; baked into the static site) -------------------
# Link shown to admins for re-running the analysis (GitHub Actions workflow page).
VITE_ADMIN_RERUN_URL=https://github.com/<org>/<repo>/actions/workflows/release-radar.yml

# ---- Pipeline: UiPath API trigger (SECRET values - GitHub Actions secrets) ------------
UIPATH_TRIGGER_URL=https://cloud.uipath.com/<org>/<tenant>/orchestrator_/t/<trigger-id>/<slug>
# Option A (recommended): External Application, client credentials (service identity)
UIPATH_ORG=<org>
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_SCOPES=OR.Jobs
# Option B: Personal Access Token (tied to one person; scope OR.Jobs only, short expiry).
# Locally you can leave it empty: start-local.bat asks for it at run time and does not save it.
UIPATH_PAT=

# ---- Pipeline: behaviour (not secret) -----------------------------------------------
UIPATH_INPUT_ARG=release_notes_markdown
# text (default): chunk sent as a String argument (ReleaseNotes_Agent_v2).
# file: chunk uploaded as an Orchestrator job attachment and passed as a File argument.
UIPATH_INPUT_TYPE=text
UIPATH_CALL_MODE=AsyncRequestReply
RR_START_MONTH=2026-01
RR_MAX_ARGS_JSON_CHARS=8000
RR_CONCURRENCY=2
RR_CACHE_KEY=v1
# After the first full run, only the latest N months are re-checked for UiPath edits.
RR_RECHECK_MONTHS=2
# true (default): keep UiPath's original highlight text in public/data for the "original" view.
# false: publish analysis + links only (use this if the repo/site stays public).
RR_STORE_SOURCE=true
