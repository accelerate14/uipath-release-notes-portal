{
  "name": "uipath-release-notes-portal",
  "private": true,
  "version": "1.2.0",
  "description": "Release Radar: UiPath release-notes analysis portal (static site + scheduled agent pipeline)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"pipeline/tests/*.test.js\"",
    "analyze": "node pipeline/run.js",
    "analyze:dry": "node pipeline/run.js --dry-run",
    "analyze:local": "node --env-file=.env pipeline/run.js",
    "serve": "node pipeline/serve.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  }
}
